# Used only by docker-compose.yml for local development.
# Copy to .env.backend and replace the password before starting the stack.
PB_ADMIN_EMAIL=admin@7xanime.local
PB_ADMIN_PASSWORD=REPLACE_WITH_A_UNIQUE_LOCAL_PASSWORD_32_CHARS_MINIMUM

# Optional: configure Google OAuth for PocketBase.
# These are OAuth client credentials, not values for NEXT_PUBLIC_* variables.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
